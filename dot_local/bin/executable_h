#!/usr/bin/env zsh

setopt pipe_fail

if (( $# == 0 )); then
  print -u2 'usage: h command [argument ...]'
  exit 2
fi

output="$(NO_COLOR=1 script -q -e /dev/null -- "$@" | sed $'s/\033\\[[0-9;]*[[:alpha:]]//g; s/\r$//')"
command_status=$?

if command -v wl-copy >/dev/null 2>&1; then
  print -rn -- "$output" | wl-copy
elif command -v clip.exe >/dev/null 2>&1; then
  print -rn -- "$output" | clip.exe
else
  print -u2 'h: no supported clipboard command found'
  exit 127
fi

exit "$command_status"
