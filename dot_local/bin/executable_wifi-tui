#!/usr/bin/env -S deno run --allow-run=nmcli,fzf,gum --ext=ts

const decoder = new TextDecoder();
const encoder = new TextEncoder();

type CommandResult = {
  code: number;
  stdout: string;
  stderr: string;
};

type RunOptions = {
  input?: string;
  interactive?: boolean;
};

type Network = {
  active: boolean;
  ssid: string;
  security: string;
  signal: number;
};

type Connection = {
  uuid: string;
  timestamp: number;
};

async function run(
  command: string,
  args: string[],
  options: RunOptions = {},
): Promise<CommandResult> {
  let stdin: "inherit" | "null" | "piped" = "null";
  let stderr: "inherit" | "piped" = "piped";
  if (options.interactive) {
    stdin = "inherit";
    stderr = "inherit";
  }
  if (options.input !== undefined) {
    stdin = "piped";
  }

  const child = new Deno.Command(command, {
    args,
    stdin,
    stdout: "piped",
    stderr,
  }).spawn();

  if (options.input !== undefined) {
    const writer = child.stdin.getWriter();
    await writer.write(encoder.encode(options.input));
    await writer.close();
  }

  const output = await child.output();
  let errorOutput = "";
  if (!options.interactive) {
    errorOutput = decoder.decode(output.stderr);
  }
  return {
    code: output.code,
    stdout: decoder.decode(output.stdout),
    stderr: errorOutput,
  };
}

async function runChecked(command: string, args: string[]): Promise<string> {
  const result = await run(command, args);
  if (result.code !== 0) {
    throw new Error(result.stderr.trim() || `${command} failed`);
  }
  return result.stdout;
}

async function runInteractive(command: string, args: string[]): Promise<number> {
  const status = await new Deno.Command(command, {
    args,
    stdin: "inherit",
    stdout: "inherit",
    stderr: "inherit",
  }).spawn().status;
  return status.code;
}

function parseTerse(line: string): string[] {
  const fields: string[] = [];
  let field = "";
  let escaped = false;

  for (const character of line) {
    if (escaped) {
      field += character;
      escaped = false;
    } else if (character === "\\") {
      escaped = true;
    } else if (character === ":") {
      fields.push(field);
      field = "";
    } else {
      field += character;
    }
  }

  if (escaped) {
    field += "\\";
  }
  fields.push(field);
  return fields;
}

function lines(output: string): string[] {
  return output.split("\n").filter((line) => line.length > 0);
}

function isEnterprise(network: Network): boolean {
  return network.security.includes("802.1X");
}

function isOpen(network: Network): boolean {
  return network.security === "" || network.security === "--";
}

async function findWifiDevice(): Promise<string> {
  const output = await runChecked("nmcli", [
    "--terse",
    "--colors",
    "no",
    "--escape",
    "yes",
    "--fields",
    "DEVICE,TYPE",
    "device",
    "status",
  ]);

  for (const line of lines(output)) {
    const [device, type] = parseTerse(line);
    if (type === "wifi") {
      return device;
    }
  }
  throw new Error("No Wi-Fi device found.");
}

async function listNetworks(device: string): Promise<Network[]> {
  const output = await runChecked("nmcli", [
    "--terse",
    "--colors",
    "no",
    "--escape",
    "yes",
    "--fields",
    "IN-USE,SSID,SECURITY,SIGNAL",
    "device",
    "wifi",
    "list",
    "--rescan",
    "yes",
    "ifname",
    device,
  ]);
  const networks = new Map<string, Network>();

  for (const line of lines(output)) {
    const [inUse, ssid, security, signalText] = parseTerse(line);
    if (!ssid) {
      continue;
    }

    const network = {
      active: inUse === "*",
      ssid,
      security,
      signal: Number(signalText),
    };
    const saved = networks.get(ssid);
    if (!saved || network.signal > saved.signal) {
      networks.set(ssid, network);
    }
  }

  return [...networks.values()].sort((left, right) =>
    right.signal - left.signal
  );
}

async function chooseNetwork(networks: Network[]): Promise<Network | null> {
  const rows = networks.map((network, index) => {
    let active = " ";
    if (network.active) {
      active = "*";
    }
    let security = network.security;
    if (isOpen(network)) {
      security = "open";
    }
    return `${index}\t${active}\t${network.ssid}\t${network.signal}%\t${security}`;
  });
  const result = await run(
    "fzf",
    [
      "--with-nth=2..",
      "--delimiter=\\t",
      "--header=IN-USE  SSID  SIGNAL  SECURITY   (enter: connect, esc: quit)",
      "--prompt=wifi> ",
    ],
    { input: `${rows.join("\n")}\n`, interactive: true },
  );

  if (result.code !== 0) {
    return null;
  }
  const index = Number(result.stdout.split("\t", 1)[0]);
  return networks[index] ?? null;
}

async function connectionSsid(uuid: string): Promise<string> {
  const output = await runChecked("nmcli", [
    "--terse",
    "--colors",
    "no",
    "--escape",
    "yes",
    "--get-values",
    "802-11-wireless.ssid",
    "connection",
    "show",
    "uuid",
    uuid,
  ]);
  const [line = ""] = output.split("\n", 1);
  return parseTerse(line)[0];
}

async function connectionIdentity(uuid: string): Promise<string> {
  const output = await runChecked("nmcli", [
    "--terse",
    "--colors",
    "no",
    "--escape",
    "yes",
    "--get-values",
    "802-1x.identity",
    "connection",
    "show",
    "uuid",
    uuid,
  ]);
  const [line = ""] = output.split("\n", 1);
  return parseTerse(line)[0];
}

async function findConnection(ssid: string): Promise<Connection | null> {
  const output = await runChecked("nmcli", [
    "--terse",
    "--colors",
    "no",
    "--escape",
    "yes",
    "--fields",
    "UUID,TYPE,TIMESTAMP",
    "connection",
    "show",
  ]);
  const candidates: Connection[] = [];

  for (const line of lines(output)) {
    const [uuid, type, timestampText] = parseTerse(line);
    if (type !== "wifi" && type !== "802-11-wireless") {
      continue;
    }
    if (await connectionSsid(uuid) === ssid) {
      candidates.push({ uuid, timestamp: Number(timestampText) });
    }
  }

  candidates.sort((left, right) => right.timestamp - left.timestamp);
  return candidates[0] ?? null;
}

async function prompt(
  label: string,
  password = false,
  value = "",
): Promise<string | null> {
  const args = ["input", `--placeholder=${label}`];
  if (password) {
    args.push("--password");
  }
  if (value) {
    args.push(`--value=${value}`);
  }
  const result = await run("gum", args, { interactive: true });
  if (result.code !== 0) {
    return null;
  }
  return result.stdout.replace(/\r?\n$/, "");
}

async function readCredentials(identityValue = ""): Promise<{
  identity: string;
  password: string;
} | null> {
  const identity = await prompt("Username", false, identityValue);
  if (identity === null) {
    return null;
  }
  const password = await prompt("Password", true);
  if (password === null) {
    return null;
  }
  return { identity, password };
}

async function connect(uuid: string, ssid: string, device: string): Promise<number> {
  return await runInteractive("gum", [
    "spin",
    "--show-error",
    "--title",
    `Connecting to ${ssid}...`,
    "--",
    "nmcli",
    "connection",
    "up",
    "uuid",
    uuid,
    "ifname",
    device,
  ]);
}

async function updateCredentials(
  connection: Connection,
  identity: string,
  password: string,
): Promise<void> {
  await runChecked("nmcli", [
    "connection",
    "modify",
    "uuid",
    connection.uuid,
    "802-1x.identity",
    identity,
    "802-1x.password",
    password,
  ]);
}

async function addEnterpriseConnection(
  network: Network,
  credentials: { identity: string; password: string },
): Promise<Connection> {
  const uuid = crypto.randomUUID();
  await runChecked("nmcli", [
    "connection",
    "add",
    "type",
    "wifi",
    "connection.uuid",
    uuid,
    "con-name",
    network.ssid,
    "ssid",
    network.ssid,
    "wifi-sec.key-mgmt",
    "wpa-eap",
    "802-1x.eap",
    "peap",
    "802-1x.phase2-auth",
    "mschapv2",
    "802-1x.identity",
    credentials.identity,
    "802-1x.password",
    credentials.password,
  ]);
  return { uuid, timestamp: 0 };
}

async function connectNew(network: Network, device: string): Promise<number> {
  if (isOpen(network)) {
    return await runInteractive("gum", [
      "spin",
      "--show-error",
      "--title",
      `Connecting to ${network.ssid}...`,
      "--",
      "nmcli",
      "device",
      "wifi",
      "connect",
      network.ssid,
      "ifname",
      device,
    ]);
  }

  if (isEnterprise(network)) {
    const credentials = await readCredentials();
    if (!credentials) {
      return 0;
    }
    const connection = await addEnterpriseConnection(network, credentials);
    return await connect(connection.uuid, network.ssid, device);
  }

  const password = await prompt("Password", true);
  if (password === null) {
    return 0;
  }
  return await runInteractive("gum", [
    "spin",
    "--show-error",
    "--title",
    `Connecting to ${network.ssid}...`,
    "--",
    "nmcli",
    "device",
    "wifi",
    "connect",
    network.ssid,
    "password",
    password,
    "ifname",
    device,
  ]);
}

async function main(): Promise<number> {
  const device = await findWifiDevice();
  const networks = await listNetworks(device);
  const network = await chooseNetwork(networks);
  if (!network) {
    return 0;
  }

  const connection = await findConnection(network.ssid);
  if (!connection) {
    return await connectNew(network, device);
  }

  const firstAttempt = await connect(connection.uuid, network.ssid, device);
  if (firstAttempt === 0 || !isEnterprise(network)) {
    return firstAttempt;
  }

  const identity = await connectionIdentity(connection.uuid);
  const credentials = await readCredentials(identity);
  if (!credentials) {
    return 0;
  }
  await updateCredentials(connection, credentials.identity, credentials.password);
  return await connect(connection.uuid, network.ssid, device);
}

try {
  Deno.exit(await main());
} catch (error) {
  let message = String(error);
  if (error instanceof Error) {
    message = error.message;
  }
  console.error(message);
  Deno.exit(1);
}
