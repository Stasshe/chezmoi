#!/usr/bin/env bash

set -euo pipefail

output_path=${1:?"Usage: screen-capture OUTPUT_PATH"}
desktop=${XDG_CURRENT_DESKTOP:-}

mkdir -p "$(dirname "$output_path")"

capture_hyprland() {
  command -v grim >/dev/null || {
    printf '%s\n' 'grim is required for Hyprland screenshots.' >&2
    return 1
  }

  grim "$output_path"
}

capture_gnome() {
  local screenshot_dir
  local started_at
  local screenshot_path
  local attempt

  command -v ydotool >/dev/null || {
    printf '%s\n' 'ydotool is required for GNOME screenshots.' >&2
    return 1
  }

  screenshot_dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
  mkdir -p "$screenshot_dir"
  started_at=$(date +%s.%N)

  ydotool key 42:1 99:1 99:0 42:0

  for attempt in {1..20}; do
    screenshot_path=$(find "$screenshot_dir" -maxdepth 1 -type f -name '*.png' -newermt "@$started_at" -printf '%T@ %p\n' |
      sort -nr |
      sed -n '1s/^[^ ]* //p')

    if [[ -n "$screenshot_path" ]]; then
      cp -- "$screenshot_path" "$output_path"
      return 0
    fi

    sleep 0.1
  done

  printf '%s\n' 'GNOME did not create a screenshot.' >&2
  return 1
}

if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} || $desktop == *Hyprland* ]]; then
  capture_hyprland
elif [[ $desktop == *GNOME* ]]; then
  capture_gnome
else
  printf 'Unsupported desktop: %s\n' "${desktop:-unknown}" >&2
  exit 1
fi
