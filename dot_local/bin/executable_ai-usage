#!/usr/bin/env node

const { spawn } = require("node:child_process");
const fs = require("node:fs/promises");
const os = require("node:os");
const path = require("node:path");
const readline = require("node:readline");

const REQUEST_TIMEOUT_MS = 10_000;
const CACHE_TTL_MS = 60_000;
const LOCK_STALE_MS = 20_000;
let cacheDirectory = path.join(os.homedir(), ".cache", "ai-usage");
if (process.env.XDG_CACHE_HOME) {
  cacheDirectory = path.join(process.env.XDG_CACHE_HOME, "ai-usage");
}
const cachePath = path.join(cacheDirectory, "usage.json");
const lockPath = path.join(cacheDirectory, "refresh.lock");

function delay(milliseconds) {
  return new Promise((resolve) => setTimeout(resolve, milliseconds));
}

async function readCache() {
  try {
    const cached = JSON.parse(await fs.readFile(cachePath, "utf8"));
    if (typeof cached.updatedAt !== "number" || typeof cached.payload !== "object") {
      return null;
    }
    return cached;
  } catch {
    return null;
  }
}

async function writeCache(payload) {
  await fs.mkdir(cacheDirectory, { recursive: true });
  const temporaryPath = `${cachePath}.${process.pid}`;
  await fs.writeFile(temporaryPath, JSON.stringify({ updatedAt: Date.now(), payload }), "utf8");
  await fs.rename(temporaryPath, cachePath);
}

async function acquireRefreshLock() {
  await fs.mkdir(cacheDirectory, { recursive: true });
  try {
    return await fs.open(lockPath, "wx");
  } catch (error) {
    if (error.code !== "EEXIST") {
      throw error;
    }
  }

  try {
    const lock = await fs.stat(lockPath);
    if (Date.now() - lock.mtimeMs <= LOCK_STALE_MS) {
      return null;
    }
    await fs.unlink(lockPath);
  } catch (error) {
    if (error.code !== "ENOENT") {
      throw error;
    }
  }

  try {
    return await fs.open(lockPath, "wx");
  } catch (error) {
    if (error.code === "EEXIST") {
      return null;
    }
    throw error;
  }
}

async function waitForRefresh(previousUpdatedAt) {
  for (let attempt = 0; attempt < 100; attempt += 1) {
    await delay(100);
    const cached = await readCache();
    if (cached && cached.updatedAt > previousUpdatedAt) {
      return cached.payload;
    }
  }
  throw new Error("AI usage refresh timed out");
}

function durationLabel(minutes) {
  if (minutes % 10_080 === 0) {
    return `${minutes / 10_080}w`;
  }
  if (minutes % 1_440 === 0) {
    return `${minutes / 1_440}d`;
  }
  if (minutes % 60 === 0) {
    return `${minutes / 60}h`;
  }
  return `${minutes}m`;
}

function codexWindow(window) {
  if (!window || typeof window.usedPercent !== "number") {
    return null;
  }

  const duration = window.windowDurationMins;
  let label = "limit";
  if (typeof duration === "number") {
    label = durationLabel(duration);
  }
  let resetsAt = null;
  if (typeof window.resetsAt === "number") {
    resetsAt = new Date(window.resetsAt * 1000).toISOString();
  }
  return {
    label,
    usedPercent: window.usedPercent,
    resetsAt,
  };
}

function readCodexUsage() {
  return new Promise((resolve, reject) => {
    const child = spawn("codex", ["app-server", "--stdio"], {
      stdio: ["pipe", "pipe", "pipe"],
    });
    const lines = readline.createInterface({ input: child.stdout });
    let settled = false;
    let stderr = "";

    const finish = (error, value) => {
      if (settled) {
        return;
      }
      settled = true;
      clearTimeout(timer);
      lines.close();
      child.kill();
      if (error) {
        reject(error);
        return;
      }
      resolve(value);
    };

    const timer = setTimeout(() => {
      finish(new Error("Codex usage request timed out"));
    }, REQUEST_TIMEOUT_MS);

    child.stderr.on("data", (chunk) => {
      stderr += chunk.toString();
    });
    child.on("error", finish);
    child.on("exit", (code) => {
      if (!settled) {
        const detail = stderr.trim() || `exit code ${code}`;
        finish(new Error(`Codex app-server failed: ${detail}`));
      }
    });

    lines.on("line", (line) => {
      let message;
      try {
        message = JSON.parse(line);
      } catch {
        return;
      }

      if (message.id === 1 && message.result) {
        child.stdin.write(`${JSON.stringify({ method: "initialized" })}\n`);
        child.stdin.write(
          `${JSON.stringify({ id: 2, method: "account/rateLimits/read", params: null })}\n`,
        );
        return;
      }

      if (message.id !== 2) {
        return;
      }
      if (message.error) {
        finish(new Error(message.error.message || "Codex usage request failed"));
        return;
      }

      const result = message.result || {};
      const limits = result.rateLimitsByLimitId?.codex || result.rateLimits || {};
      const windows = [codexWindow(limits.primary), codexWindow(limits.secondary)].filter(Boolean);
      finish(null, { windows });
    });

    child.stdin.write(
      `${JSON.stringify({
        id: 1,
        method: "initialize",
        params: {
          clientInfo: { name: "ai-usage-bar", version: "1" },
          capabilities: { experimentalApi: true },
        },
      })}\n`,
    );
  });
}

function claudeWindow(label, window) {
  if (!window || typeof window.utilization !== "number") {
    return null;
  }
  return {
    label,
    usedPercent: window.utilization,
    resetsAt: window.resets_at ?? null,
  };
}

async function readClaudeUsage() {
  const configDirectory = process.env.CLAUDE_CONFIG_DIR || path.join(os.homedir(), ".claude");
  const credentialsPath = path.join(configDirectory, ".credentials.json");
  const credentials = JSON.parse(await fs.readFile(credentialsPath, "utf8"));
  const oauth = credentials.claudeAiOauth;
  const accessToken = oauth?.accessToken;
  if (!accessToken) {
    throw new Error("Claude OAuth credentials are unavailable");
  }
  if (typeof oauth.expiresAt === "number" && oauth.expiresAt <= Date.now()) {
    throw new Error("Claude sign-in expired; open Claude Code once to refresh it");
  }

  const response = await fetch("https://api.anthropic.com/api/oauth/usage", {
    headers: {
      Authorization: `Bearer ${accessToken}`,
      "anthropic-beta": "oauth-2025-04-20",
    },
    signal: AbortSignal.timeout(REQUEST_TIMEOUT_MS),
  });
  if (!response.ok) {
    throw new Error(`Claude usage request failed with HTTP ${response.status}`);
  }

  const usage = await response.json();
  const windows = [
    claudeWindow("5h", usage.five_hour),
    claudeWindow("7d", usage.seven_day),
  ].filter(Boolean);
  return { windows };
}

function providerResult(result, fallback) {
  if (result.status === "fulfilled") {
    return result.value;
  }
  const windows = fallback?.windows || [];
  return { error: result.reason?.message || String(result.reason), windows };
}

async function main() {
  const forceRefresh = process.argv.includes("--refresh");
  const cached = await readCache();
  if (!forceRefresh && cached && Date.now() - cached.updatedAt < CACHE_TTL_MS) {
    process.stdout.write(`${JSON.stringify(cached.payload)}\n`);
    return;
  }

  const lock = await acquireRefreshLock();
  if (!lock) {
    const payload = await waitForRefresh(cached?.updatedAt || 0);
    process.stdout.write(`${JSON.stringify(payload)}\n`);
    return;
  }

  try {
    const [codex, claude] = await Promise.allSettled([readCodexUsage(), readClaudeUsage()]);
    const payload = {
      codex: providerResult(codex, cached?.payload?.codex),
      claude: providerResult(claude, cached?.payload?.claude),
    };
    await writeCache(payload);
    process.stdout.write(`${JSON.stringify(payload)}\n`);
  } finally {
    await lock.close();
    await fs.unlink(lockPath).catch(() => {});
  }
}

main().catch((error) => {
  process.stdout.write(`${JSON.stringify({ error: error.message })}\n`);
  process.exitCode = 1;
});
