#!/usr/bin/env python3

import os
import sys
from pathlib import Path

EXCLUDED_USERS = {
    "public",
    "default",
    "default user",
    "all users",
    "defaultaccount",
    "wdagutilityaccount",
}

def find_downloads() -> Path:
    users_dir = Path("/mnt/c/Users")

    if not users_dir.is_dir():
        print(f"dl: {users_dir} does not exist", file=sys.stderr)
        raise SystemExit(1)

    candidates = [
        user_dir / "Downloads"
        for user_dir in users_dir.iterdir()
        if user_dir.is_dir()
        and user_dir.name.casefold() not in EXCLUDED_USERS
        and (user_dir / "Downloads").is_dir()
    ]

    if len(candidates) != 1:
        print(
            f"dl: expected exactly one Windows Downloads directory, "
            f"found {len(candidates)}",
            file=sys.stderr,
        )

        for candidate in candidates:
            print(f"  {candidate}", file=sys.stderr)

        raise SystemExit(1)

    return candidates[0]


def main() -> None:
    if len(sys.argv) < 2:
        print("Usage: dl FILE...", file=sys.stderr)
        raise SystemExit(2)

    downloads = find_downloads()

    os.execvp(
        "cp",
        [
            "cp",
            "--",
            *sys.argv[1:],
            f"{downloads}/",
        ],
    )


if __name__ == "__main__":
    main()
