#!/usr/bin/env bash
set -euo pipefail

user_home={{ .chezmoi.homeDir | quote }}

files=(
  ".claude/hooks/noctalia-pulse"
  ".config/burn-my-windows/profiles/smooth.conf"
  ".config/fcitx5/private_profile"
  ".config/ghostty/config"
  ".config/hypr/custom/env.lua"
  ".config/hypr/custom/execs.lua"
  ".config/hypr/custom/general.lua"
  ".config/hypr/custom/keybinds.lua"
  ".config/hypr/custom/variables.lua"
  ".config/hypr/hyprland.lua"
  ".config/hypr/hyprland/colors.lua"
  ".config/hypr/hyprland/env.lua"
  ".config/hypr/hyprland/execs.lua"
  ".config/hypr/hyprland/general.lua"
  ".config/hypr/hyprland/keybinds.lua"
  ".config/hypr/hyprland/lib/init.lua"
  ".config/hypr/hyprland/rules.lua"
  ".config/hypr/hyprland/scripts/ai/license_show-loaded-ollama-models.txt"
  ".config/hypr/hyprland/scripts/ai/primary-buffer-query.sh"
  ".config/hypr/hyprland/scripts/ai/show-loaded-ollama-models.sh"
  ".config/hypr/hyprland/scripts/launch_first_available.sh"
  ".config/hypr/hyprland/services/init.lua"
  ".config/hypr/hyprland/services/literal_create_custom_config.lua"
  ".config/hypr/hyprland/shellOverrides/main.lua"
  ".config/hypr/hyprland/variables.lua"
  ".config/mimeapps.list"
  ".config/mozc/ibus_config.textproto"
  ".config/noctalia/config.toml"
  ".config/xdg-desktop-portal/hyprland-portals.conf"
  ".config/zellij/config.kdl.bak"
  ".local/bin/screen-capture"
  ".local/bin/wifi-tui"
  ".local/share/backgrounds/nebula.png"
  ".local/share/backgrounds/orbit.png"
  ".local/share/gnome-shell/extensions/soft-grid@flux/extension.js"
  ".local/share/gnome-shell/extensions/soft-grid@flux/metadata.json"
  ".local/share/gnome-shell/extensions/soft-grid@flux/stylesheet.css"
  ".local/share/remoteview/desktop-pc.desktop"
)

directories=(
  ".config/burn-my-windows/profiles"
  ".config/burn-my-windows"
  ".config/fcitx5"
  ".config/ghostty"
  ".config/hypr/custom"
  ".config/hypr/hyprland/lib"
  ".config/hypr/hyprland/scripts/ai"
  ".config/hypr/hyprland/scripts"
  ".config/hypr/hyprland/services"
  ".config/hypr/hyprland/shellOverrides"
  ".config/hypr/hyprland"
  ".config/hypr"
  ".config/mozc"
  ".config/noctalia"
  ".config/xdg-desktop-portal"
  ".local/share/backgrounds"
  ".local/share/gnome-shell/extensions/soft-grid@flux"
  ".local/share/gnome-shell/extensions"
  ".local/share/gnome-shell"
  ".local/share/remoteview"
)

for file in "${files[@]}"; do
  rm -f -- "$user_home/$file"
done

for directory in "${directories[@]}"; do
  target="$user_home/$directory"
  if [[ -d "$target" && ! -L "$target" ]]; then
    rmdir --ignore-fail-on-non-empty -- "$target"
  fi
done
