# ============================================================
# Font
# ============================================================

font-family = CaskaydiaMono Nerd Font Mono

# Do not configure fallback font families.
# Keep the original font metrics and size.


# ============================================================
# Theme and colors
# ============================================================

theme = Catppuccin Mocha

# Guarantee readable text even when applications choose
# unfortunate foreground/background combinations.
minimum-contrast = 1.3

# Apply transparency to application-painted backgrounds too.
# This keeps transparency inside Neovim, zellij, tmux, etc.
background-opacity = 0.90
background-opacity-cells = true

# Blur support depends on the desktop compositor.
# KDE Plasma supports this natively.
# Standard Ubuntu GNOME may ignore it.
background-blur = true


# ============================================================
# Window
# ============================================================

window-theme = ghostty
window-decoration = auto

window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
window-padding-color = background

window-inherit-font-size = true
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true

window-save-state = always
window-new-tab-position = current
window-show-tab-bar = auto

# Avoid tearing while keeping animations and scrolling smooth.
window-vsync = true

# Clean UI.
scrollbar = never

# Show terminal dimensions briefly while resizing.
resize-overlay = after-first
resize-overlay-position = bottom-right
resize-overlay-duration = 450ms


# ============================================================
# Cursor
# ============================================================

cursor-style = block
cursor-style-blink = true
cursor-opacity = 0.90

# Move the shell cursor by clicking inside the current prompt.
cursor-click-to-move = true

# Ghostty shell integration normally changes the prompt cursor
# to a bar. Keep that behavior because it distinguishes shell
# editing from full-screen terminal applications.


# ============================================================
# Splits
# ============================================================

# Make the active pane immediately recognizable.
unfocused-split-opacity = 0.82
unfocused-split-fill = 11111b
split-divider-color = 45475a

# Preserve zoom while navigating across panes.
split-preserve-zoom = navigation

# Focus panes by moving the mouse over them.
focus-follows-mouse = true


# ============================================================
# Shell integration
# ============================================================

shell-integration = zsh

# Enable useful integration for sudo and remote SSH sessions.
shell-integration-features = cursor,sudo,ssh-env,ssh-terminfo

# New tabs and splits follow the current shell directory.
shell-integration-features = cursor,sudo,ssh-env,ssh-terminfo


# ============================================================
# Mouse and selection
# ============================================================

mouse-hide-while-typing = true

# Selecting text copies it to both the X11 selection clipboard
# and the normal desktop clipboard.
copy-on-select = clipboard

# Convenient terminal-style right click.
right-click-action = copy-or-paste

selection-clear-on-typing = true
selection-clear-on-copy = false

link-url = true
link-previews = osc8


# ============================================================
# Scrolling
# ============================================================

scrollback-limit = 100000000

# Return to the latest output whenever a normal key is entered.
scroll-to-bottom = keystroke

# Slightly faster than the conservative default.
mouse-scroll-multiplier = 1.5


# ============================================================
# Safety and behavior
# ============================================================

# Shell integration suppresses this confirmation when Ghostty
# knows that only an idle shell prompt is open.
confirm-close-surface = true

clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true
clipboard-trim-trailing-spaces = false

# Notify only for commands that ran long enough to matter.
notify-on-command-finish = unfocused
notify-on-command-finish-after = 10s


# ============================================================
# Bell
# ============================================================

# Visual notification without terminal beep noise.
bell-features = attention,title
bell-audio-volume = 0


# ============================================================
# Rendering
# ============================================================

# Better blending around colored glyph edges.
alpha-blending = linear-corrected

# Prevent ligatures from crossing cursor and selection boundaries
# while preserving normal programming ligatures.
font-shaping-break = cursor

# Keep Nerd Font icons vertically balanced.
adjust-icon-height = 0%


# ============================================================
# Animated custom shader
# ============================================================

# Ghostty does not provide general-purpose window/tab transition
# animations on Linux. Continuous visual animation is implemented
# through custom GLSL shaders.
#
# Uncomment after creating the shader:
#
# custom-shader = ~/.config/ghostty/shaders/subtle-glow.glsl
# custom-shader-animation = true
