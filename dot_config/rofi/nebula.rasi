* {
  background: #0a0e20d9;
  surface: #151b35e6;
  text: #e2e8f0;
  muted: #94a3b8;
  accent: #c4b5fd;
  border: #ffffff24;
}

window {
  width: 540px;
  border: 1px;
  border-radius: 20px;
  border-color: @border;
  background-color: @background;
}

mainbox { padding: 14px; spacing: 10px; }
inputbar { padding: 12px 14px; border-radius: 13px; background-color: @surface; text-color: @text; }
prompt { text-color: @accent; margin: 0 10px 0 0; }
entry { text-color: @text; placeholder: "Search your space"; placeholder-color: @muted; }
listview { lines: 7; columns: 1; spacing: 6px; scrollbar: false; }
element { padding: 10px 12px; border-radius: 12px; background-color: transparent; }
element-text { text-color: @text; }
element-icon { size: 28px; }
element selected { background-color: #c4b5fd26; }
element selected element-text { text-color: @accent; }

