{
  "permissions": {
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf $HOME/*)",

      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(chmod -R 777 *)",
      "Bash(chown -R *)",

      "Bash(mkfs *)",
      "Bash(dd *)",
      "Bash(mount *)",
      "Bash(umount *)",

      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)",

      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Bash(git clean -fdx *)",
      "Bash(git rebase *)",

      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(yarn publish *)",

      "Bash(npm unpublish *)",
      "Bash(pnpm unpublish *)",

      "Bash(docker system prune *)",
      "Bash(docker volume rm *)",
      "Bash(docker volume prune *)",
      "Bash(docker compose down -v *)",

      "Bash(gh repo delete *)",
      "Bash(gh auth token *)",
      "Bash(gh secret set *)",

      "Bash(pass *)",

      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(**/.env)",
      "Read(**/.env.local)"
    ],
    "allow": [
      "Bash(ls)",
      "Bash(pwd)",
      "Bash(whoami)",
      "Bash(id)",
      "Bash(date)",
      "Bash(cal)",
      "Bash(df -h)",
      "Bash(du -h)",
      "Bash(free -h)",
      "Bash(top -n 1 -b)",
      "Bash(sed -n *p *)",


      "Bash(pnpm add *)",
      "Bash(pnpm run *)",
      "Bash(pnpm exec *)"

    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "caveman@caveman": true,
    "genshijin@genshijin": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "genshijin": {
      "source": {
        "source": "github",
        "repo": "InterfaceX-co-jp/genshijin"
      }
    }
  },
  "theme": "dark"
}