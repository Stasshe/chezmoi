# --- interactive only ---
[[ -o interactive ]] || return

# --- PATH ---
export PATH="$HOME/.local/bin:$PATH"

# Ruby user gems. Globbed rather than asked of `ruby -e "print Gem.user_dir"`,
# which costs 255ms per shell start for a path that only moves on a ruby upgrade.
_gem_bin=("$HOME"/.local/share/gem/ruby/*/bin(N/))
if (( $#_gem_bin )); then
  export PATH="${_gem_bin[-1]}:$PATH"
fi
unset _gem_bin

# --- mise ---
if [ -x "$HOME/.local/bin/mise" ]; then
  eval "$("$HOME/.local/bin/mise" activate zsh)"
  # activate hooks both precmd and chpwd; precmd re-runs `mise hook-env`
  # (~176ms) before every prompt. The env only changes on cd, so drop precmd.
  add-zsh-hook -d precmd _mise_hook_precmd
fi

# --- Oh My Zsh (selective) ---
# oh-my-zsh.sh sources every lib/*.zsh plus an update check, and a third of
# those libs only feed omz's own prompt themes, which oh-my-posh replaces here.
# Source the live ones directly. Order matters: functions.zsh defines helpers
# the later libs call, and syntax-highlighting must come after every widget.
export ZSH="$HOME/.oh-my-zsh"

if [ -d "$ZSH" ]; then
  ZSH_CACHE_DIR="$ZSH/cache"
  fpath=("$ZSH/plugins/git" "$ZSH/functions" "$ZSH/completions"
         "$ZSH_CACHE_DIR/completions" $fpath)

  ZSH_COMPDUMP="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump"
  [[ -d "${ZSH_COMPDUMP:h}" ]] || mkdir -p "${ZSH_COMPDUMP:h}"
  autoload -Uz compinit
  # Rescan fpath for new completions once a day; trust the dump in between.
  if [[ -n ${ZSH_COMPDUMP}(#qN.mh-24) ]]; then
    compinit -C -d "$ZSH_COMPDUMP"
  else
    compinit -d "$ZSH_COMPDUMP"
  fi

  # git_current_branch and friends live in lib/git.zsh, so the git plugin needs
  # it. async-prompt off stops it registering a precmd hook nothing consumes.
  zstyle ':omz:alpha:lib:git' async-prompt no

  for _omz_lib in functions history directories grep clipboard termsupport \
                  theme-and-appearance key-bindings completion misc git; do
    source "$ZSH/lib/$_omz_lib.zsh"
  done
  unset _omz_lib

  source "$ZSH/plugins/git/git.plugin.zsh"
  source "$ZSH/custom/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
  source "$ZSH/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

# --- Prompt ---
if command -v oh-my-posh >/dev/null 2>&1 && [ -f "$HOME/.poshthemes/unicorn.omp.json" ]; then
  eval "$(oh-my-posh init zsh --config "$HOME/.poshthemes/unicorn.omp.json")"
fi

# --- Options ---
setopt IGNOREEOF
setopt no_flow_control
setopt share_history
setopt hist_ignore_dups
setopt hist_ignore_all_dups
setopt auto_cd

# --- Alias ---
alias d='docker'
alias dc='docker compose'

alias bd="$HOME/competitive/atcoder/sh/build.sh"
alias io="$HOME/competitive/atcoder/sh/io.sh"

alias youtube-dl='cd ~/dev/tools/youtube-downloader && npm run start'
alias ql='ollama launch claude --model qwen3.5:9b'
alias qd='ollama run qwen3.5:9b'
alias qd4='ollama run qwen3.5:4b'
alias qc='ollama run qwen2.5:7b'
alias y='yazi'
alias laz='lazygit'
alias lad='lazydocker'
alias ch='chezmoi'
alias fetch='git fetch -p'

alias zap='JAVA_HOME="$(mise where java)" /usr/local/bin/zap.sh'


diffnav() {
  if [[ -t 0 && $# -eq 0 ]]; then
    command diffnav --watch --watch-cmd "git diff HEAD"
    return
  fi

  command diffnav "$@"
}

upd-claudemd() (
  set -e
  cd "$(chezmoi source-path)"
  cp dot_claude/CLAUDE.md dot_codex/AGENTS.md
  chezmoi apply
  git add dot_claude/CLAUDE.md dot_codex/AGENTS.md
  git commit -m "update-claude.md"
)

if command -v eza >/dev/null 2>&1; then
  alias ls='eza --icons --group-directories-first'
  alias ll='eza --la --icons --group-directories-first --git'
  alias lt='eza --tree --level=2 --icons'
else
  alias ll='ls -la'
fi

# --- zoxide ---
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

# --- fzf ---
if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
fi

unset LANGUAGE
export LC_MESSAGES=C.UTF-8
